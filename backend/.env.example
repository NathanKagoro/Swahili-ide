# Backend
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
USE_LLM=true
LLM_PROVIDER=openrouter

# Model choices
STT_PROVIDER=deepgram
WHISPER_MODEL=base
DEEPGRAM_API_KEY=7fd5ade975854c053c792605624144359246db65
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=sw
DEEPGRAM_AGENT_ENABLED=false
DEEPGRAM_AGENT_LISTEN_MODEL=nova-3
DEEPGRAM_AGENT_THINK_MODEL=gpt-4o-mini
DEEPGRAM_AGENT_SPEAK_MODEL=aura-2-thalia-en
DEEPGRAM_AGENT_GREETING=Hi, I am Amina. How can I help with your Python or Pyswahili code today?
TTS_PROVIDER=piper
TTS_VOICE=sw
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Only used when LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=60
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=Swahili Voice IDE
OPENROUTER_SITE_URL=

# Local Piper (relative paths are resolved from backend/)
PIPER_EXECUTABLE_PATH=
PIPER_MODEL_PATH=
PIPER_MODEL_CONFIG_PATH=
PIPER_EN_MODEL_PATH=
PIPER_EN_MODEL_CONFIG_PATH=

# Optional external APIs
OPENAI_API_KEY=
TOGETHER_API_KEY=

# Runtime limits
CODE_EXEC_TIMEOUT_SECONDS=5
MAX_INPUT_CHARS=8000
